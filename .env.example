PROJECT_NAME=neuro_sleep_lakehouse_platform
ENV=local

# Docker images
POSTGRES_IMAGE=postgres@sha256:22c89fe0d0f507606260237fd55e51f6137f58b2d5bcf6152242b96d9fe8f9a4
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=neuro_sleep
POSTGRES_USER=neuro_sleep
POSTGRES_PASSWORD=change_me_postgres_password

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key

ACTIVE_SOURCE=sleep_edf

SLEEP_EDF_VERSION=1.0.0
# sample mode: 0 means no recording limit
SLEEP_EDF_MAX_RECORDINGS=4
SLEEP_EDF_INCLUDE_CASSETTE=true
SLEEP_EDF_INCLUDE_TELEMETRY=true
SLEEP_EDF_INCLUDE_METADATA=true

# Optional explicit recording allowlist for sample mode.
SLEEP_EDF_RECORDING_KEYS=

# Set false to build metadata/channels/intervals/epochs only.
SILVER_INCLUDE_SIGNALS=true
